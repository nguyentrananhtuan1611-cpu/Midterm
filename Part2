
import SwiftUI

// MARK: - Equipment Model

class Equipment: Identifiable {
    let equipmentID: String
    let purchaseYear: Int

    var id: String { equipmentID }

    private(set) var name: String
    private(set) var manufacturer: String
    private(set) var isAvailable: Bool

    init(
        equipmentID: String,
        name: String,
        manufacturer: String,
        purchaseYear: Int
    ) {
        self.equipmentID = equipmentID
        self.name = name
        self.manufacturer = manufacturer
        self.purchaseYear = purchaseYear
        self.isAvailable = true
    }

    func updateInformation(name: String, manufacturer: String) {
        self.name = name
        self.manufacturer = manufacturer
    }

    func borrow() -> Bool {
        guard isAvailable else { return false }
        isAvailable = false
        return true
    }

    func returnEquipment() -> Bool {
        guard !isAvailable else { return false }
        isAvailable = true
        return true
    }

    func displayInfo() -> String {
        """
        ID: \(equipmentID)
        Name: \(name)
        Manufacturer: \(manufacturer)
        Purchase Year: \(purchaseYear)
        Status: \(isAvailable ? "Available" : "Borrowed")
        """
    }
}

