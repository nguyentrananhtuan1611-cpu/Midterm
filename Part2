// MARK: - Equipment Detail

struct EquipmentDetailView: View {
    @ObservedObject var store: EquipmentStore
    let equipment: Equipment

    @State private var borrower = ""
    @State private var alertMessage = ""
    @State private var showAlert = false

    var body: some View {
        Form {
            Section("Equipment Information") {
                infoRow("ID", equipment.equipmentID)
                infoRow("Name", equipment.name)
                infoRow("Manufacturer", equipment.manufacturer)
                infoRow("Purchase Year", "\(equipment.purchaseYear)")

                HStack {
                    Text("Status")
                    Spacer()
                    Text(equipment.isAvailable ? "Available" : "Borrowed")
                        .foregroundStyle(
                            equipment.isAvailable ? .green : .red
                        )
                }
            }

            Section("Category Information") {
                if let laptop = equipment as? Laptop {
                    infoRow("Processor", laptop.processor)
                    infoRow("Memory", "\(laptop.memory) GB")
                    infoRow("Storage", "\(laptop.storage) GB")
                }

                if let tablet = equipment as? Tablet {
                    infoRow("Screen Size", "\(tablet.screenSize) inches")
                    infoRow("Battery", "\(tablet.batteryCapacity) mAh")
                    infoRow("Supports Pen", tablet.supportsPen ? "Yes" : "No")
                }

                if let camera = equipment as? DigitalCamera {
                    infoRow("Resolution", "\(camera.resolution) MP")
                    infoRow("Optical Zoom", "\(camera.opticalZoom)x")
                }
            }

            Section {
                NavigationLink("Edit Equipment") {
                    EquipmentFormView(
                        store: store,
                        editingEquipment: equipment
                    )
                }
            }

            Section("Borrowing") {
                if equipment.isAvailable {
                    TextField("Borrower's Name", text: $borrower)

                    Button("Borrow Equipment") {
                        borrowEquipment()
                    }
                    .disabled(borrower.trimmingCharacters(
                        in: .whitespaces
                    ).isEmpty)

                    Button("Test Invalid Return") {
                        returnEquipment()
                    }
                    .foregroundStyle(.red)
                } else {
                    Button("Return Equipment") {
                        returnEquipment()
                    }
                    .foregroundStyle(.green)
                }
            }

            Section {
                NavigationLink("Borrowing History") {
                    EquipmentBorrowingHistoryView(
                        store: store,
                        equipmentID: equipment.equipmentID
                    )
                }
            }
        }
        .navigationTitle("Equipment Details")
        .alert("Result", isPresented: $showAlert) {
            Button("OK", role: .cancel) { }
        } message: {
            Text(alertMessage)
        }
    }

    private func infoRow(_ title: String, _ value: String) -> some View {
        HStack {
            Text(title)
            Spacer()
            Text(value)
                .foregroundStyle(.secondary)
        }
    }

    private func borrowEquipment() {
        do {
            try store.borrowEquipment(
                equipmentID: equipment.equipmentID,
                borrower: borrower
            )

            alertMessage = "Equipment borrowed successfully."
            borrower = ""
        } catch {
            alertMessage = error.localizedDescription
        }

        showAlert = true
    }

    private func returnEquipment() {
        do {
            try store.returnEquipment(
                equipmentID: equipment.equipmentID
            )

            alertMessage = "Equipment returned successfully."
        } catch {
            alertMessage = error.localizedDescription
        }

        showAlert = true
    }
}

// MARK: - Register and Edit Equipment

struct EquipmentFormView: View {
    @ObservedObject var store: EquipmentStore

    var editingEquipment: Equipment?

    @Environment(\.dismiss) private var dismiss

    @State private var equipmentID = ""
    @State private var name = ""
    @State private var manufacturer = ""
    @State private var purchaseYear = "\(Calendar.current.component(.year, from: Date()))"

    @State private var category = "Laptop"

    @State private var processor = ""
    @State private var memory = "16"
    @State private var storage = "512"

    @State private var screenSize = "10.9"
    @State private var batteryCapacity = "7600"
    @State private var supportsPen = true

    @State private var resolution = "24.2"
    @State private var opticalZoom = "3"

    @State private var alertMessage = ""
    @State private var showAlert = false
    @State private var shouldDismiss = false

    private var isEditing: Bool {
        editingEquipment != nil
    }

    var body: some View {
        Form {
            Section("Basic Information") {
                TextField("Equipment ID", text: $equipmentID)
                    .disabled(isEditing)

                TextField("Name", text: $name)

                TextField("Manufacturer", text: $manufacturer)

                TextField("Purchase Year", text: $purchaseYear)
                    .keyboardType(.numberPad)
                    .disabled(isEditing)
            }

            if !isEditing {
                Section("Equipment Category") {
                    Picker("Category", selection: $category) {
                        Text("Laptop").tag("Laptop")
                        Text("Tablet").tag("Tablet")
                        Text("Digital Camera").tag("Digital Camera")
                    }
                }

                if category == "Laptop" {
                    Section("Laptop Information") {
                        TextField("Processor", text: $processor)

                        TextField("Memory (GB)", text: $memory)
                            .keyboardType(.numberPad)

                        TextField("Storage (GB)", text: $storage)
                            .keyboardType(.numberPad)
                    }
                }

                if category == "Tablet" {
                    Section("Tablet Information") {
                        TextField("Screen Size (inches)", text: $screenSize)
                            .keyboardType(.decimalPad)

                        TextField("Battery Capacity (mAh)", text: $batteryCapacity)
                            .keyboardType(.numberPad)

                        Toggle("Supports Digital Pen", isOn: $supportsPen)
                    }
                }

                if category == "Digital Camera" {
                    Section("Camera Information") {
                        TextField("Resolution (MP)", text: $resolution)
                            .keyboardType(.decimalPad)

                        TextField("Optical Zoom", text: $opticalZoom)
                            .keyboardType(.numberPad)
                    }
                }
            }

            Section {
                Button(isEditing ? "Save Changes" : "Register Equipment") {
                    saveEquipment()
                }
            }
        }
        .navigationTitle(isEditing ? "Edit Equipment" : "Register Equipment")
        .onAppear {
            loadEditingData()
        }
        .alert("Result", isPresented: $showAlert) {
            Button("OK") {
                if shouldDismiss {
                    dismiss()
                }
            }
        } message: {
            Text(alertMessage)
        }
    }

    private func loadEditingData() {
        guard let equipment = editingEquipment else { return }

        equipmentID = equipment.equipmentID
        name = equipment.name
        manufacturer = equipment.manufacturer
        purchaseYear = "\(equipment.purchaseYear)"
    }

    private func saveEquipment() {
        let cleanID = equipmentID.trimmingCharacters(in: .whitespaces)
        let cleanName = name.trimmingCharacters(in: .whitespaces)
        let cleanManufacturer = manufacturer.trimmingCharacters(in: .whitespaces)

        guard !cleanID.isEmpty,
              !cleanName.isEmpty,
              !cleanManufacturer.isEmpty,
              let year = Int(purchaseYear),
              year > 0,
              year <= Calendar.current.component(.year, from: Date()) else {
            showError("Please enter valid basic information.")
            return
        }

        if isEditing {
            do {
                try store.updateEquipment(
                    id: cleanID,
                    name: cleanName,
                    manufacturer: cleanManufacturer
                )

                showSuccess("Equipment updated successfully.")
            } catch {
                showError(error.localizedDescription)
            }

            return
        }

        let newEquipment: Equipment

        switch category {
        case "Laptop":
            guard !processor.trimmingCharacters(in: .whitespaces).isEmpty,
                  let ram = Int(memory),
                  let disk = Int(storage),
                  ram > 0, disk > 0 else {
                showError("Please enter valid laptop information.")
                return
            }

            newEquipment = Laptop(
                equipmentID: cleanID,
                name: cleanName,
                manufacturer: cleanManufacturer,
                purchaseYear: year,
                processor: processor,
                memory: ram,
                storage: disk
            )

        case "Tablet":
            guard let size = Double(screenSize),
                  let battery = Int(batteryCapacity),
                  size > 0, battery > 0 else {
                showError("Please enter valid tablet information.")
                return
            }

            newEquipment = Tablet(
                equipmentID: cleanID,
                name: cleanName,
                manufacturer: cleanManufacturer,
                purchaseYear: year,
                screenSize: size,
                batteryCapacity: battery,
                supportsPen: supportsPen
            )

        default:
            guard let mp = Double(resolution),
                  let zoom = Int(opticalZoom),
                  mp > 0, zoom > 0 else {
                showError("Please enter valid camera information.")
                return
            }

            newEquipment = DigitalCamera(
                equipmentID: cleanID,
                name: cleanName,
                manufacturer: cleanManufacturer,
                purchaseYear: year,
                resolution: mp,
                opticalZoom: zoom
            )
        }

        do {
            try store.registerEquipment(newEquipment)
            showSuccess("Equipment registered successfully.")
        } catch {
            showError(error.localizedDescription)
        }
    }

    private func showError(_ message: String) {
        alertMessage = message
        shouldDismiss = false
        showAlert = true
    }

    private func showSuccess(_ message: String) {
        alertMessage = message
        shouldDismiss = true
        showAlert = true
    }
}

// MARK: - Borrowing History

struct BorrowingHistoryView: View {
    @ObservedObject var store: EquipmentStore

    var body: some View {
        List {
            if store.borrowingRecords.isEmpty {
                ContentUnavailableView(
                    "No Borrowing Records",
                    systemImage: "clock"
                )
            } else {
                ForEach(store.borrowingRecords) { record in
                    VStack(alignment: .leading, spacing: 6) {
                        Text(record.equipment.name)
                            .font(.headline)

                        Text("ID: \(record.equipment.equipmentID)")
                        Text("Borrower: \(record.borrower)")

                        Text("Borrow Date: \(record.borrowDate.formatted(date: .abbreviated, time: .shortened))")

                        if let returnDate = record.returnDate {
                            Text("Return Date: \(returnDate.formatted(date: .abbreviated, time: .shortened))")
                                .foregroundStyle(.green)
                        } else {
                            Text("Currently Borrowed")
                                .foregroundStyle(.orange)
                        }
                    }
                    .font(.subheadline)
                }
            }
        }
        .navigationTitle("Borrowing History")
    }
}

// MARK: - Equipment Borrowing History

struct EquipmentBorrowingHistoryView: View {
    @ObservedObject var store: EquipmentStore
    let equipmentID: String

    private var records: [BorrowingRecord] {
        store.getBorrowingHistory(equipmentID: equipmentID)
    }

    var body: some View {
        List {
            if records.isEmpty {
                ContentUnavailableView(
                    "No History",
                    systemImage: "clock"
                )
            } else {
                ForEach(records) { record in
                    VStack(alignment: .leading, spacing: 6) {
                        Text("Borrower: \(record.borrower)")
                            .font(.headline)

                        Text("Borrow Date: \(record.borrowDate.formatted(date: .abbreviated, time: .shortened))")

                        if let returnDate = record.returnDate {
                            Text("Return Date: \(returnDate.formatted(date: .abbreviated, time: .shortened))")
                                .foregroundStyle(.green)
                        } else {
                            Text("Not Returned")
                                .foregroundStyle(.orange)
                        }
                    }
                    .font(.subheadline)
                }
            }
        }
        .navigationTitle("Equipment History")
    }
}
