// MARK: - Borrowing Record

class BorrowingRecord: Identifiable {
    let id = UUID()
    let borrower: String
    let equipment: Equipment
    let borrowDate: Date

    private(set) var returnDate: Date?

    var isReturned: Bool {
        returnDate != nil
    }

    init(borrower: String, equipment: Equipment) {
        self.borrower = borrower
        self.equipment = equipment
        self.borrowDate = Date()
    }

    func returnItem() -> Bool {
        guard !isReturned else { return false }

        guard equipment.returnEquipment() else {
            return false
        }

        returnDate = Date()
        return true
    }
}

// MARK: - Errors

enum EquipmentStoreError: LocalizedError {
    case duplicateID
    case equipmentNotFound
    case invalidInput
    case equipmentUnavailable
    case alreadyBorrowed
    case noActiveBorrowing

    var errorDescription: String? {
        switch self {
        case .duplicateID:
            return "Equipment ID already exists."

        case .equipmentNotFound:
            return "Equipment not found."

        case .invalidInput:
            return "Please enter valid information."

        case .equipmentUnavailable:
            return "This equipment is not available."

        case .alreadyBorrowed:
            return "This equipment already has an active borrowing record."

        case .noActiveBorrowing:
            return "This equipment has not been borrowed."

        }
    }
}

// MARK: - Equipment Store

class EquipmentStore: ObservableObject {
    @Published private(set) var equipmentList: [Equipment] = []
    @Published private(set) var borrowingRecords: [BorrowingRecord] = []

    init() {
        loadSampleData()
    }

    private func loadSampleData() {
        equipmentList = [
            Laptop(
                equipmentID: "LAP001",
                name: "Dell XPS 15",
                manufacturer: "Dell",
                purchaseYear: 2024,
                processor: "Intel Core i7",
                memory: 16,
                storage: 512
            ),

            Tablet(
                equipmentID: "TAB001",
                name: "iPad Air",
                manufacturer: "Apple",
                purchaseYear: 2023,
                screenSize: 10.9,
                batteryCapacity: 7600,
                supportsPen: true
            ),

            DigitalCamera(
                equipmentID: "CAM001",
                name: "Canon EOS R50",
                manufacturer: "Canon",
                purchaseYear: 2024,
                resolution: 24.2,
                opticalZoom: 3
            )
        ]
    }

    func registerEquipment(_ equipment: Equipment) throws {
        guard !equipmentList.contains(where: {
            $0.equipmentID == equipment.equipmentID
        }) else {
            throw EquipmentStoreError.duplicateID
        }

        equipmentList.append(equipment)
    }

    func retrieveEquipment(byID id: String) -> Equipment? {
        equipmentList.first {
            $0.equipmentID == id
        }
    }

    func getAllEquipment() -> [Equipment] {
        equipmentList
    }

    func updateEquipment(
        id: String,
        name: String,
        manufacturer: String
    ) throws {
        guard let equipment = retrieveEquipment(byID: id) else {
            throw EquipmentStoreError.equipmentNotFound
        }

        guard !name.trimmingCharacters(in: .whitespaces).isEmpty,
              !manufacturer.trimmingCharacters(in: .whitespaces).isEmpty else {
            throw EquipmentStoreError.invalidInput
        }

        equipment.updateInformation(
            name: name,
            manufacturer: manufacturer
        )

        objectWillChange.send()
    }

    func borrowEquipment(
        equipmentID: String,
        borrower: String
    ) throws {
        guard let equipment = retrieveEquipment(byID: equipmentID) else {
            throw EquipmentStoreError.equipmentNotFound
        }

        guard !borrower.trimmingCharacters(in: .whitespaces).isEmpty else {
            throw EquipmentStoreError.invalidInput
        }

        guard !borrowingRecords.contains(where: {
            $0.equipment.equipmentID == equipmentID && !$0.isReturned
        }) else {
            throw EquipmentStoreError.alreadyBorrowed
        }

        guard equipment.isAvailable else {
            throw EquipmentStoreError.equipmentUnavailable
        }

        guard equipment.borrow() else {
            throw EquipmentStoreError.equipmentUnavailable
        }

        let record = BorrowingRecord(
            borrower: borrower,
            equipment: equipment
        )

        borrowingRecords.append(record)
        objectWillChange.send()
    }

    func returnEquipment(equipmentID: String) throws {
        guard let record = borrowingRecords.last(where: {
            $0.equipment.equipmentID == equipmentID && !$0.isReturned
        }) else {
            throw EquipmentStoreError.noActiveBorrowing
        }

        guard record.returnItem() else {
            throw EquipmentStoreError.noActiveBorrowing
        }

        objectWillChange.send()
    }

    func getBorrowingHistory(equipmentID: String) -> [BorrowingRecord] {
        borrowingRecords.filter {
            $0.equipment.equipmentID == equipmentID
        }
    }

    func getActiveBorrowings() -> [BorrowingRecord] {
        borrowingRecords.filter { !$0.isReturned }
    }
}

